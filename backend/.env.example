PORT=8080
HOST=127.0.0.1
NODE_ENV=production
# При общем HTTPS reverse proxy оставьте пустым. При прямом доступе укажите точный HTTPS-origin frontend.
# Например: CORS_ORIGINS=https://propusk.example.local
CORS_ORIGINS=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=PassCard

# Используются только командой npm run auth:init-admin
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-long-password
INITIAL_ADMIN_NAME=Администратор
